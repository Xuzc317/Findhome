# ===========================================
# 前端环境变量模板
# 复制为 frontend/.env 并填写实际值（.env 已被 git 忽略）
# ===========================================

# 高德 JS API Key（服务平台必须选「Web端(JS API)」）
# 申请: https://console.amap.com/dev/key/app
VITE_AMAP_KEY=your_amap_js_key_here

# 高德 JS API v2.0 安全密钥（与上面的 JS Key 配套，控制台同一页面可查看）
VITE_AMAP_SECURITY_CODE=your_amap_security_code_here

# 注意：后端的地理编码/POI/步行路径/地铁同步 需要**另一个**「Web服务」类型的 Key，
# 那个填在项目根目录的 .env：AMAP_WEB_KEY=...
# 一个 Key 不能同时用于 JS API 与 Web 服务，高德会返回 10009「请求 Key 与绑定平台不符」。
