# ===========================================
# HouseSearch Local v1 - 配置文件模板
# 复制此文件为 .env 并填写实际值
# ===========================================

# 数据库（留空即可，默认使用 <项目根>/data/houses.db；相对路径会自动按项目根解析）
# DATABASE_URL=sqlite:///data/houses.db

# 高德地图 JS API Key（前端地图展示，也可直接配到 frontend/.env 的 VITE_AMAP_KEY）
# 获取地址：https://lbs.amap.com/api/javascriptapi/guide/abc/prepare
AMAP_KEY=your_amap_key_here

# 高德地图 Web Service API Key（用于后端通勤计算）
AMAP_WEB_KEY=your_amap_web_key_here

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 爬虫配置
# 请求间隔（秒），建议不要设置过小以免对平台造成压力
CRAWL_INTERVAL=2

# 小红书 Cookie（登录后从浏览器复制）
XIAOHONGSHU_COOKIE=

# 贝壳 Cookie（登录后从浏览器复制）
BEIKE_COOKIE=

# 闲鱼 Cookie（登录后从浏览器复制）
XIANYU_COOKIE=

# 豆瓣 Cookie（登录后从浏览器复制）
DOUBAN_COOKIE=

# 通勤目的地（格式："经度,纬度" 或地址名称）
COMMUTE_DESTINATION=腾讯滨海大厦
COMMUTE_DESTINATION_LNG=113.943
COMMUTE_DESTINATION_LAT=22.528
