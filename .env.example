# ===========================================
# HouseSearch Local v1 - 配置文件模板
# 复制此文件为 .env 并填写实际值（.env 已被 .gitignore 忽略）
# ===========================================

# 数据库（留空即可，默认使用 <项目根>/data/houses.db；相对路径会自动按项目根解析）
# DATABASE_URL=sqlite:///data/houses.db

# ===========================================
# 高德地图（两类 Key 不通用，必须分别申请）
# ===========================================
# 【Web服务】Key —— 后端用：地理编码、POI 搜索、步行路径、地铁站同步
# 申请：https://console.amap.com/dev/key/app → 添加Key → 服务平台选「Web服务」
AMAP_WEB_KEY=your_amap_web_key_here

# 【Web端(JS API)】Key —— 前端地图用，填到 frontend/.env 的 VITE_AMAP_KEY
# 与配套的「安全密钥」填 frontend/.env 的 VITE_AMAP_SECURITY_CODE
# 注意：把 JS Key 填到 AMAP_WEB_KEY 会返回 10009「请求 Key 与绑定平台不符」
AMAP_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# ===========================================
# 大模型（用于从文字/图片推断房源位置）
# ===========================================
# auto = 有豆包用豆包（支持图片），否则用 DeepSeek；两者都配时互为兜底
LLM_PROVIDER=auto
# 抽取任务关闭「思考」可大幅提速降本（实测 67s→1.7s，约 3900→25 tokens）
LLM_THINKING=disabled
LLM_TIMEOUT=120
# 单条房源最多分析几张图片（控制成本）
LLM_MAX_IMAGES=2
LLM_VISION_ENABLED=true

# DeepSeek（纯文本，适合从标题正文抽取小区/地铁站）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 豆包 / 火山方舟（支持图片理解）
# DOUBAO_MODEL 可填模型 ID（如 doubao-seed-2-1-lite-260915）或推理接入点 ep-xxxxxxxx
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 爬虫配置
# 请求间隔（秒），建议不要设置过小以免对平台造成压力
CRAWL_INTERVAL=2

# ===========================================
# 平台 Cookie（只使用你本人浏览器登录后的 Cookie，本项目不要密码）
# 获取方式：浏览器登录 → 开发者工具 → Network → 任意请求 → 复制 Cookie 请求头
# ===========================================
XIAOHONGSHU_COOKIE=
BEIKE_COOKIE=
XIANYU_COOKIE=
DOUBAN_COOKIE=

# 通勤目的地（格式："经度,纬度" 或地址名称）
COMMUTE_DESTINATION=腾讯滨海大厦
COMMUTE_DESTINATION_LNG=113.943
COMMUTE_DESTINATION_LAT=22.528
